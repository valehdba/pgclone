# pgclone extension
comment = 'Clone PostgreSQL databases, schemas, tables, roles and permissions with selective columns, data filtering, data masking/anonymization, async, parallel cloning, materialized views, resume, and conflict resolution, and Oracle-to-PostgreSQL table cloning (optional OCI build)'
default_version = '4.5.0'
module_pathname = '$libdir/pgclone'
relocatable = false
superuser = true
