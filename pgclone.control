# pgclone extension
comment = 'Clone PostgreSQL databases, schemas, tables, roles and permissions with selective columns, data filtering, data masking/anonymization, async, parallel cloning, materialized views, resume, and conflict resolution, and Oracle-, SQL Server- and MySQL-to-PostgreSQL table cloning (optional OCI / FreeTDS / MySQL client builds)'
default_version = '4.7.0'
module_pathname = '$libdir/pgclone'
relocatable = false
superuser = true
